{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm tenant:sync && pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sb/:path*",
      "destination": "https://vbttfadurpolbefzbbgj.supabase.co/:path*"
    },
    {
      "source": "/((?!sb/|assets|tenants|sw\\.js|sw-push\\.js|workbox-|icon-|apple-touch-icon|manifest\\.webmanifest|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/tenants/(.*)/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sb/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}

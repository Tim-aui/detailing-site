{
  "name": "detailing-booking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@astryxdesign/core"
    ]
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/tenant-sync.ts && vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "tenant:new": "node --experimental-strip-types scripts/tenant-new.ts",
    "tenant:validate": "node --experimental-strip-types scripts/tenant-validate.ts",
    "tenant:sync": "node --experimental-strip-types scripts/tenant-sync.ts",
    "tenant:publish": "node --experimental-strip-types scripts/tenant-publish.ts",
    "tenant:verify": "node --experimental-strip-types scripts/tenant-verify.ts",
    "tenant:push": "node --experimental-strip-types scripts/tenant-push.ts",
    "tenant:owner": "node --experimental-strip-types scripts/tenant-owner.ts",
    "test:db": "bash supabase/tests/run.sh && bash supabase/tests/race.sh"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.3",
    "@astryxdesign/theme-neutral": "^0.6.3",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "liquid-gl": "^3.0.0",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5",
    "supabase": "^2.118.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22.6"
  }
}

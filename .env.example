# Скопируйте в .env.local (он не попадает в git) и заполните.

# --- Браузер (попадают в бандл: только публичные значения!) ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# Публичный VAPID-ключ для напоминаний (npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# --- Только скрипты администратора (никогда с префиксом VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=
# Адрес опубликованного сайта для pnpm tenant:verify
SITE_URL=https://your-project.vercel.app

# --- Секреты функций Supabase задаются НЕ здесь, а командой:
#   pnpm supabase secrets set OPENAI_API_KEY=… OPENAI_MODEL=gpt-4.1-mini …
# Список — в docs/SETUP.md.
